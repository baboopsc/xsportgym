# Bu dosya örnektir. Kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası GİZLİDİR: GitHub'a gönderilmez, kimseyle paylaşılmaz.

# ---------- Zorunlu ----------
# iyzico anahtarları (test için sandbox-merchant.iyzipay.com > Ayarlar > Firma Ayarları)
IYZICO_API_KEY=sandbox-...
IYZICO_SECRET_KEY=sandbox-...
# Test: https://sandbox-api.iyzipay.com   Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Sitenin adresi (canlıda https://www.xsportgym.com gibi)
SITE_URL=http://localhost:3000
PORT=3000

# Neon > Connect > bağlantı adresi (Neon projesini Frankfurt / AWS eu-central-1 bölgesinde açın)
DATABASE_URL=postgresql://kullanici:sifre@sunucu/neondb?sslmode=verify-full

# İLK KURULUM: veritabanında yönetici yoksa bu bilgilerle yönetici hesabı açılır.
# Sonrasında kullanıcı adı/şifre panelden (Hesabım sekmesi) değiştirilir; bu satırlar artık kullanılmaz.
# Şifre unutulursa:  node yonetici-olustur.js KULLANICI_ADI 'YeniŞifre'
ADMIN_KULLANICI_ADI=admin
# node sifre-olustur.js 'GüçlüBirŞifre'  komutunun çıktısı (TEK TIRNAK içinde)
ADMIN_SIFRE_HASH='$2b$12$...'
# Rastgele uzun bir değer:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=...

# ---------- E-posta (canlıda zorunlu) ----------
# Gmail için: Google hesabında 2 adımlı doğrulamayı açın, sonra "Uygulama şifreleri"nden 16 haneli şifre alın.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_KULLANICI=xsportgym@gmail.com
SMTP_SIFRE=uygulama-sifresi
EPOSTA_GONDEREN=Xsportgym <xsportgym@gmail.com>
# Yeni sipariş bildirimlerinin gideceği adres (salonun e-postası)
ADMIN_EPOSTA=xsportgym@gmail.com

# ---------- Canlıda ----------
# NODE_ENV=production   (e-posta ayarları da girilmeden açmayın, sunucu başlamaz)
# TRUST_PROXY=1         (Render gibi bir sunucunun arkasında gerçek IP için)

# ---------- İsteğe bağlı ----------
# Taksit seçenekleri (1 = tek çekim)
# TAKSITLER=1,2,3,6,9
# Ödeme bu kadar dakikada tamamlanmazsa sipariş "yarım kaldı" olur
# TERK_SURESI_DK=45
# Bir IP'den 10 dakikada en fazla kaç ödeme başlatılabilir
# ODEME_BASLATMA_LIMITI=15
# Ödeme yöntemi: havale (IBAN'a havale/EFT, varsayılan) ya da iyzico (kartla ödeme; IYZICO_* ayarları gerekir)
# ODEME_YONTEMI=havale
# Arka plan işlerini kapat (sadece özel durumlar için)
# ISLER_KAPALI=1
